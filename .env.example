# =====================================================
# স্মার্ট কৃষি সহকারী — Environment Configuration
# Smart Agriculture Assistant — Environment Variables
# =====================================================
# এই ফাইলটি কপি করে .env নামে সেভ করুন এবং মান পরিবর্তন করুন।
# Copy this file as .env and fill in your values.
# cp .env.example .env
# =====================================================


# ─────────────────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=krishi_db
DB_USER=postgres
DB_PASSWORD=your_password_here


# ─────────────────────────────────────────────────────
# Ollama (Local LLM)
# ─────────────────────────────────────────────────────
# Ollama চালু করার পর এই URL কাজ করবে।
# Run: ollama serve (then: ollama pull qwen3:0.6b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b


# ─────────────────────────────────────────────────────
# Anthropic Claude API (Image Vision Analysis)
# ─────────────────────────────────────────────────────
# Claude Free tier ব্যবহার করা হচ্ছে crop disease detection এর জন্য।
# Get your API key at: https://console.anthropic.com
# ছবি বিশ্লেষণ বন্ধ রাখতে চাইলে এই key খালি রাখুন।
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ─────────────────────────────────────────────────────
# Open-Meteo Weather API
# ─────────────────────────────────────────────────────
# Open-Meteo সম্পূর্ণ বিনামূল্যে — কোনো API key দরকার নেই।
# No API key required for Open-Meteo. Leave as is.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast


# ─────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────
APP_PORT=8000

# Default language: 'bn' (বাংলা) বা 'en' (English)
DEFAULT_LANGUAGE=bn

# Debug mode (production এ False রাখুন)
DEBUG=False
